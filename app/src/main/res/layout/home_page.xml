<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_clean_gradient">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="90dp"
        android:fontFamily="@font/ROGONEZ"
        android:text="Puzzle 15"
        android:textColor="@color/white"
        android:textSize="48sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/sozlar"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:fontFamily="@font/Youre"
            android:layout_marginBottom="24dp"
            android:background="@drawable/edit_text_back"
            android:elevation="2dp"
            android:hint="Person information"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8"
            android:textSize="10sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/startbtn"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:fontFamily="@font/Youre"
            android:layout_marginBottom="16dp"
            android:background="@drawable/btn_back"
            android:elevation="6dp"
            android:letterSpacing="0.05"
            android:stateListAnimator="@null"
            android:text="Start"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/continio"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:background="@drawable/btn_back"
            android:elevation="6dp"
            android:letterSpacing="0.05"
            android:fontFamily="@font/Youre"
            android:stateListAnimator="@null"
            android:text="Continue"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/infon"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/btn_back"
            android:elevation="6dp"
            android:letterSpacing="0.05"
            android:fontFamily="@font/Youre"
            android:stateListAnimator="@null"
            android:text="Info"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_exit"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/btn_back"
            android:elevation="6dp"
            android:letterSpacing="0.05"
            android:stateListAnimator="@null"
            android:text="Exit"
            android:textAllCaps="false"
            android:fontFamily="@font/Youre"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>